# Docker Compose reads this file for ${...} interpolation. These values are not
# injected into the Episode container.

# Immutable image used by this release. Change this deliberately when upgrading.
EPISODE_IMAGE=ghcr.io/openepisode/episode:0.1.0-beta.4

# The UI is private unless Alarm Server or Event API pushes require LAN access.
EPISODE_HTTP_BIND=127.0.0.1
EPISODE_FTP_BIND=0.0.0.0

# Match the owner of ./data on Linux hosts.
EPISODE_UID=1000
EPISODE_GID=1000

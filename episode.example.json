{
  "data_dir": "/var/episode/data",
  "api_host": "0.0.0.0",
  "api_port": 8989,
  "episode_timeout": 30,
  "log_level": "INFO",
  "actions": {
    "recording": {
      "segment_seconds": 600
    },
    "snapshot": {
      "enabled": false
    }
  },
  "connectors": [
    {
      "type": "event_api",
      "enabled": true,
      "settings": {
        "name": "Event API",
        "path": "/api/v1/events",
        "max_payload_bytes": 65536
      }
    },
    {
      "type": "alarm_server",
      "enabled": true,
      "settings": {
        "name": "Alarm Server",
        "path": "/alarm"
      }
    },
    {
      "type": "ftp",
      "enabled": true,
      "settings": {
        "name": "FTP Snapshots",
        "host": "0.0.0.0",
        "port": 2121,
        "username": "episode",
        "password": "replace-with-a-long-password",
        "passive_ports": [
          30000,
          30009
        ]
      }
    }
  ],
  "thumbnail": {
    "enabled": true,
    "max_width": 480,
    "max_height": 320,
    "quality": 75,
    "cache_dir": ""
  },
  "plugins": []
}
